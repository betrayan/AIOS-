<?xml version="1.0" encoding="utf-8"?>
<!--
    Buddy AI OS — Data Extraction Rules
    Privacy-first: all user data is excluded from cloud backup and device transfer.
    Conversations, memories, and tasks never leave the device via backup mechanisms.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
