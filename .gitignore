# Buddy AI OS — .gitignore

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Android Studio
.idea/
*.iws
*.iml
*.ipr
local.properties

# Virtual device files
.android/

# Android
/captures
.externalNativeBuild
.cxx
*.apk
*.aab
*.ap_

# Firebase & Google Services
google-services.json

# Keystore files (NEVER commit keystores)
*.jks
*.keystore
release-keystore.properties
signing.properties

# OS files
.DS_Store
Thumbs.db

# Kotlin
*.class
bin/

# Room schema (should be tracked — do NOT gitignore)
# app/schemas/ is intentionally NOT listed here

# ProGuard mapping (keep per release)
# mapping.txt

# Crash reporting
crashlytics-build.properties
fabric.properties
